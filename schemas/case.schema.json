{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://koschei.invalid/schemas/sentinel.case.v1.json",
  "title": "Koschei Sentinel Security Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "target_ref", "network", "signed_verdict", "evidence"],
  "properties": {
    "schema_version": {"const": "sentinel.case.v1"},
    "case_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "target_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "network": {"type": "string", "minLength": 1, "maxLength": 64},
    "signed_verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grade", "signature", "triggered_rules", "summary"],
      "properties": {
        "grade": {"enum": ["A", "B", "C", "D", "F", "-"]},
        "signature": {"type": "string", "minLength": 8, "maxLength": 256},
        "triggered_rules": {"type": "array", "items": {"type": "string"}, "maxItems": 128},
        "summary": {"type": "string", "minLength": 1, "maxLength": 4000}
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "kind", "statement", "confidence"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "kind": {"type": "string", "minLength": 1, "maxLength": 64},
          "statement": {"type": "string", "minLength": 1, "maxLength": 4000},
          "confidence": {"enum": ["VERIFIED", "INFERRED", "UNVERIFIED"]},
          "rule_ids": {"type": "array", "items": {"type": "string"}, "maxItems": 64},
          "attributes": {"type": "object"}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}, "maxItems": 128}
  }
}
