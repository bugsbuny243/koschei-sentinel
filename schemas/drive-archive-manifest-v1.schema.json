{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sentinel.drive-archive-manifest.v1",
  "title": "Koschei Sentinel Drive Archive Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "artifact_kind",
    "archive_folder_env",
    "source_manifest_sha256",
    "files",
    "file_count",
    "total_bytes",
    "artifact_digest"
  ],
  "properties": {
    "schema_version": {"const": "sentinel.drive-archive-manifest.v1"},
    "artifact_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "artifact_kind": {
      "enum": [
        "CHECKPOINT",
        "DATASET_RELEASE",
        "MODEL_ADAPTER",
        "EVALUATION",
        "GENERIC_ARTIFACT"
      ]
    },
    "archive_folder_env": {"const": "KOSCHEI_DRIVE_ARCHIVE_FOLDER_ID"},
    "source_manifest_sha256": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 1024},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "file_count": {"type": "integer", "minimum": 1, "maximum": 10000},
    "total_bytes": {"type": "integer", "minimum": 0},
    "artifact_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
