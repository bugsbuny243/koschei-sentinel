{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://koschei.dev/schemas/cyber-corpus-source-v3.schema.json",
  "title": "Koschei Sentinel Cyber Corpus v3 Source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "source_class",
    "domain_families",
    "provenance_tier",
    "license_status",
    "license_scope",
    "acquisition_mode",
    "training_authorization",
    "eval_exclusion",
    "review_status"
  ],
  "properties": {
    "schema_version": {"const": "sentinel.cyber-source.v3"},
    "source_id": {"type": "string", "minLength": 3},
    "source_class": {"type": "string", "minLength": 3},
    "domain_families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 2}
    },
    "provenance_tier": {"enum": ["T0_PRIMARY", "T1_AUTHORITATIVE", "T2_REVIEWED", "T3_CONTEXT_ONLY"]},
    "license_status": {"enum": ["ALLOW_TRAINING", "ALLOW_WITH_ATTRIBUTION", "REVIEW_REQUIRED", "EVAL_ONLY", "BLOCKED"]},
    "license_scope": {"enum": ["UNIFORM", "PER_ARTIFACT", "UNKNOWN"]},
    "license_reference": {"type": ["string", "null"]},
    "acquisition_mode": {"type": "string", "minLength": 3},
    "canonical_locator": {"type": ["string", "null"]},
    "pinned_revision": {"type": ["string", "null"]},
    "training_authorization": {"type": "boolean"},
    "eval_exclusion": {"type": "boolean"},
    "benchmark_overlap_risk": {"enum": ["NONE", "LOW", "MEDIUM", "HIGH", "UNKNOWN"]},
    "review_status": {"enum": ["PROPOSED", "LICENSE_REVIEW", "SECURITY_REVIEW", "APPROVED", "REJECTED", "REVOKED"]},
    "notes": {"type": ["string", "null"]}
  }
}
